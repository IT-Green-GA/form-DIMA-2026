# Configuracion local del agente.
# Copia este archivo como .env y rellena los valores. El archivo .env no se
# sube al repositorio porque contiene credenciales.

# Token del bot de Telegram. Se obtiene en @BotFather con /newbot.
TELEGRAM_TOKEN=

# Llave de OpenRouter para las respuestas automaticas.
# Se crea en https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Modelo multimodal: entiende texto, audio e imagenes en un mismo mensaje.
MODELO=qwen/qwen3.8-omni-flash

# Modelo solo texto, mas barato, para consultas que no llevan archivos.
MODELO_TEXTO=deepseek/deepseek-v4.1-flash-1017

# Puerto donde publica el servidor del curso.
PUERTO=3000

# Numero maximo de oraciones en las respuestas de texto.
MAX_ORACIONES=3

# Numero maximo de imagenes que se envian al modelo por mensaje.
MAX_IMAGENES=3